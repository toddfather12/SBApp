# Southern Bay Construction — Environment Variables

# Database (Turso cloud) — omit to use local SQLite at ./data/projects.db
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Weekly Email Updates (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@southernbayconstruction.com
ADMIN_CC_EMAIL=office@southernbayconstruction.com
APP_BASE_URL=https://yourapp.com

# Optional: override the cron schedule (default: Friday 3:30 PM)
# EMAIL_SCHEDULE=30 15 * * 5

PORT=3000
